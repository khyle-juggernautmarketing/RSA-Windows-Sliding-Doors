# Server-only — set these in Vercel Project Settings → Environment Variables
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/your-webhook-id
# JWT secret configured in n8n webhook JWT auth (HS256 Bearer token is signed server-side)
N8N_JWT_SECRET=your-jwt-secret-here
# Legacy alias — used if N8N_JWT_SECRET is not set
N8N_AUTH_BEARER=your-jwt-secret-here
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app
